{
	"name": "zen-zone",
	"version": "2.0.0",
	"description": "A focus companion: pomodoro timer, YouTube ambience and daily note task logging.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src tests --ext .ts",
		"test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/*.js"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"pomodoro",
		"focus",
		"youtube"
	],
	"author": "chacha260",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.27.1",
		"eslint": "^8.57.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
