{
	"name": "zen-zone",
	"version": "2.0.2",
	"description": "A focus companion: pomodoro timer, YouTube ambience and daily note task logging.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/*.js"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"pomodoro",
		"focus",
		"youtube"
	],
	"author": "chacha260",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.5",
		"esbuild": "^0.27.1",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"obsidian": "^1.14.4",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2"
	}
}
